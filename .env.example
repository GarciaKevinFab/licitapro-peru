# ============================================
# LICITAPRO PERÚ — CONFIGURACIÓN
# ============================================
# cp .env.example .env  y rellena lo marcado con CAMBIAR.
# Este archivo SÍ se commitea; .env NO. Nunca pongas un secreto real aquí.
# ============================================

# --- Entorno ---
# 'dev' o 'produccion'. En produccion la app exige LICITAPRO_SECRET_KEY y
# marca la cookie de sesión como https_only.
LICITAPRO_ENTORNO=dev

# Clave maestra. Cifra las credenciales guardadas y firma la cookie de sesión.
# OBLIGATORIA fuera de desarrollo: sin ella lo ya cifrado queda irrecuperable,
# así que guárdala donde no se pierda y NO la rotes sin re-cifrar.
#   Generar:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ← CAMBIAR
LICITAPRO_SECRET_KEY=

# --- Base de datos ---
# En PRODUCCIÓN se usa Supabase y la conexión viene entera en DATABASE_URL.
# Si está puesta, manda sobre las piezas sueltas de abajo (la usan tanto la app
# como Alembic).
#
# Se saca en: Supabase → Connect → **Session pooler**.
#
# DOS TRAMPAS QUE CUESTAN HORAS (las mismas de VueloRadar):
#
#   1. El puerto es 5432, NUNCA 6543. El panel enseña primero el Transaction
#      Pooler (6543), que no mantiene la sesión entre consultas y rompe las
#      migraciones con errores de "prepared statement".
#
#   2. Codifica TODOS los símbolos de la contraseña, sobre todo el @:
#      #=%23  @=%40  :=%3A  /=%2F  ?=%3F  %=%25
#      Un @ sin codificar es traicionero porque la app funciona igual, pero
#      pg_dump falla: los dos parsers cortan la URL por sitios distintos.
#      Compruébalo antes de dar nada por bueno:
#        docker run --rm postgres:17-alpine psql "$DATABASE_URL" -c "select 1"
#
DATABASE_URL=

# --- PostgreSQL (solo desarrollo; en producción manda DATABASE_URL) ---
POSTGRES_HOST=localhost
# en docker-compose.prod es 5432 (red interna)
POSTGRES_PORT=5433
POSTGRES_DB=licitapro
POSTGRES_USER=licitapro
# ← CAMBIAR: contraseña larga y aleatoria
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380

# --- Telegram ---
# Los bots se crean con @BotFather. El nombre de usuario del bot se usa para el
# enlace profundo de vinculación (https://t.me/<BOT>?start=<token>).
# ← CAMBIAR: sin la @
TELEGRAM_BOT_USERNAME=
# ← CAMBIAR
RADAR_BOT_TOKEN=
# ← CAMBIAR
PREP_BOT_TOKEN=
# ← CAMBIAR
WIN_BOT_TOKEN=

# TU id de Telegram, no el de un cliente. Aquí llegan los avisos de operación:
# el parte de cada scrapeo y, sobre todo, el de "la fuente principal lleva 12
# corridas sin traer nada", que es el único aviso de que el producto se quedó
# mudo. Sin esta variable ese aviso no se manda a ningún sitio.
#   Lo da @userinfobot en Telegram.
# ← CAMBIAR
TELEGRAM_ADMIN_ID=

# --- Izipay ---
# 'simulado' (por defecto) no cobra nada y permite probar el flujo entero.
# 'sandbox' y 'produccion' exigen MERCHANT_CODE y API_KEY; sin ellas vuelve a
# simulado en vez de intentar cobrar a medias.
IZIPAY_MODO=simulado
# ← CAMBIAR al activar cobros
IZIPAY_MERCHANT_CODE=
# ← CAMBIAR: clave pública del panel de Izipay
IZIPAY_PUBLIC_KEY=
# ← CAMBIAR: nunca la publiques en el frontend
IZIPAY_API_KEY=
# Clave para verificar la firma del webhook. Sin ella TODO webhook se rechaza,
# que es el comportamiento correcto: un webhook sin firmar es una orden de
# cobro que puede mandar cualquiera.
# ← CAMBIAR al activar cobros
IZIPAY_HMAC_KEY=

# --- WhatsApp (Meta Cloud API) ---
# 'simulado' (por defecto) no manda nada y deja probar el flujo entero.
# 'produccion' exige TOKEN y PHONE_NUMBER_ID; sin ellos vuelve a simulado en
# vez de fallar a mitad del reparto de avisos.
WHATSAPP_MODO=simulado
# ← CAMBIAR: token permanente del usuario de sistema
WHATSAPP_TOKEN=
# ← CAMBIAR: id del numero, NO el numero
WHATSAPP_PHONE_NUMBER_ID=
# Secreto de la app, para validar la firma del webhook. Sin el se rechaza TODO
# webhook: uno sin verificar deja que cualquiera dé de baja a un cliente.
# ← CAMBIAR
WHATSAPP_APP_SECRET=
# Cadena que tú inventas; Meta te la devuelve al dar de alta el webhook.
# ← CAMBIAR
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PLANTILLA_IDIOMA=es
#
# DOS PLANTILLAS QUE HAY QUE CREAR Y QUE META DEBE APROBAR.
# Categoría UTILITY en ambas (no Marketing: es más barata y se aprueba mejor).
# Los {{n}} son los parámetros, en ese orden, y NO pueden llevar saltos de línea.
#
#   1) confirmacion_licitapro  — la envía la web al guardar el número.
#      "Hola {{1}}, confirma que quieres recibir avisos de licitaciones de
#       LicitaPro en este número. Responde ALTA para activarlos."
#
#   2) aviso_licitaciones      — el resumen periódico.
#      "{{1}}, tienes {{2}} licitación(es) nueva(s) que encajan con tus filtros.
#       La primera: {{3}}. Entra a tu panel para verlas todas."
#
WHATSAPP_PLANTILLA_ALTA=confirmacion_licitapro
WHATSAPP_PLANTILLA_AVISO=aviso_licitaciones

# --- Cloudflare Tunnel (camino recomendado para publicar) ---
# El VPS no abre ningún puerto: cloudflared abre una conexión SALIENTE hacia
# Cloudflare, que termina el TLS. Sin certificados que renovar y sin IP de
# origen que alguien pueda descubrir y atacar directamente.
#
# Se saca en: Cloudflare → Zero Trust → Networks → Tunnels → Create a tunnel
# → Docker. El token va en el comando que te muestran; copia solo el token.
#
# Un mismo túnel puede servir varios proyectos: se añade otro hostname en el
# panel apuntando a otro servicio.
#
# Solo hace falta con `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

# El dominio con el que se publica. Lo lee Caddy (ver Caddyfile) para pedir y
# renovar el certificado de Let's Encrypt solo.
#
# Tiene que apuntar YA a la IP de este servidor cuando levantes el compose de
# producción: la validación se hace entrando desde fuera por el puerto 80.
#
# Sin definir, Caddy sirve en :80 SIN TLS. Sirve para comprobar el despliegue y
# no para producción: la app manda HSTS fuera de desarrollo, así que sin
# certificado real el navegador de cada visitante se queda forzando https
# contra un puerto que no lo habla.
LICITAPRO_DOMINIO=licitapro.sisac.pe

# URL pública, usada en los avisos para enlazar al panel.
LICITAPRO_URL_PUBLICA=https://licitapro.sisac.pe

# --- Claude API (análisis de viabilidad, planes Pro y Empresa) ---
# La pones TÚ y pagas el análisis de todos tus clientes. Sin ella el producto
# sigue funcionando: la ficha muestra el análisis por reglas, marcado como tal
# en pantalla para que nadie crea que pagó por el otro.
#
# Lo que cuesta, medido: ~500 tokens de entrada y ~1.700 de salida por
# análisis. Con claude-opus-5 son unos US$0,046 (S/0,17) cada uno.
#
# El gasto está acotado por `planes.analisis_ia_mes`: 60 al mes en Pro y 300 en
# Empresa. Se suben o bajan con un UPDATE, sin tocar código.
#   SELECT codigo, analisis_ia_mes FROM planes;
ANTHROPIC_API_KEY=

# Modelo y esfuerzo. Están aquí y no en el código porque cuánto gastar por
# análisis es una decisión de negocio: tiene que poder ajustarse mirando la
# factura, sin un despliegue.
#
#   claude-opus-5   el más capaz. Es el que produce los análisis que distinguen
#                   "consultoría de obra" de "ejecución de obra", que es
#                   justamente lo que un proveedor paga por saber.
#   claude-sonnet-5 unas 2,5 veces más barato por token.
#
# El esfuerzo (low | medium | high | xhigh | max) regula cuánto razona antes de
# responder. 'medium' es el punto donde los análisis siguen siendo buenos sin
# pagar de más; súbelo si los ves pobres.
LICITAPRO_MODELO_IA=claude-opus-5
LICITAPRO_IA_ESFUERZO=medium

# --- Administración ---
# Tu correo de usuario en el panel. Solo esa cuenta ve /admin/ia, la página que
# dice cuánto te cuesta la IA por plan y por cliente.
#
# Sin esta variable, /admin/ia responde 404 a TODO EL MUNDO, tú incluido. Es a
# propósito: si abriera cuando no hay nadie configurado, un despliegue con la
# variable olvidada publicaría los correos de tus clientes y su consumo.
# ← CAMBIAR
LICITAPRO_ADMIN_EMAIL=

# Tarifa para convertir tokens en dinero en esa página. Los valores de fábrica
# son los de claude-opus-5. Si cambias LICITAPRO_MODELO_IA, cambia también
# estos: los tokens guardados no caducan, el precio sí.
LICITAPRO_IA_USD_ENTRADA=5
LICITAPRO_IA_USD_SALIDA=25
LICITAPRO_TIPO_CAMBIO=3.75

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# App Password, no la contraseña de la cuenta
# DUPLICA LOS $ DE LA CONTRASENA
#
#   Docker Compose interpreta $loquesea en un env_file como una variable y la
#   sustituye por vacio. Una contrasena de 16 caracteres con un dolar llegaba
#   al contenedor con 10, y el servidor respondia "535 Incorrect
#   authentication data" -- que parece contrasena equivocada y no lo es.
#
#   Probar la contrasena a mano funciona, porque ahi no pasa por Compose. Eso
#   es lo que hace que cueste tanto encontrarlo.
#
#   Escribe $$ por cada $. El contenedor recibira uno solo.
#     contrasena real:  ab$cd1234
#     aqui se escribe:  ab$$cd1234
SMTP_PASSWORD=

# Buzón ÚNICO, tuyo, para el aviso de buena pro de win_bot. No lo uses como
# destino de las notificaciones de clientes: con varios inquilinos, el correo
# de cualquier cuenta acabaría en un buzón ajeno. Los avisos por correo de cada
# cliente salen de `user_config.email_notificaciones`, uno por usuario.
EMAIL_DESTINATARIO=

# --- Rutas ---
# Estas son las rutas DENTRO del contenedor, que es donde corre en producción.
# Para desarrollo en tu máquina cámbialas a relativas:
#   BASES_DIR=data/bases   EXPEDIENTES_DIR=data/expedientes   TEMPLATES_DIR=templates
#
# En Windows la diferencia no da error, da algo peor: /app/templates resuelve a
# C:\Program Files\Git\app\templates, los documentos se escriben allí y el ZIP
# se arma sin ellos porque zip_builder los incluye "si existen".
BASES_DIR=/app/data/bases
EXPEDIENTES_DIR=/app/data/expedientes
TEMPLATES_DIR=/app/templates

# --- Pasarela a OECE ---
# OECE devuelve 403 al trafico de datacenters fuera de Peru. Desde una
# conexion peruana su API responde 200 sin problema, asi que en desarrollo
# estas dos se dejan VACIAS y el scraper va directo.
#
# En el servidor hacen falta: apuntan a un Worker de Cloudflare que pide la
# URL desde su red y devuelve la respuesta. El codigo del Worker y sus
# instrucciones de despliegue estan en tools/worker-oece.js.
#
# Las dos o ninguna: con URL y sin secreto el Worker responde 401 y parece
# que el bloqueado eres tu.
OECE_PROXY_URL=
OECE_PROXY_SECRETO=
