# Proxy inverso con TLS. Es la pieza que faltaba para poder publicar.
#
# DESPLIEGUE.md ya traia un Caddyfile de ejemplo, pero solo como texto para
# instalar Caddy a mano en el host. Un ejemplo en la documentacion es algo que
# alguien tiene que copiar bien; esto es un servicio que arranca con el resto.
#
# POR QUE CADDY Y NO NGINX CON CERTBOT
#
#   Nginx necesita: emitir el certificado a mano la primera vez, un cron de
#   renovacion, un hook que recargue nginx al renovar, y acordarse de que todo
#   eso existe. Cada pieza puede fallar en silencio, y el sintoma llega noventa
#   dias despues en forma de navegador en rojo.
#
#   Caddy pide el certificado a Let's Encrypt solo, lo renueva solo y recarga
#   solo. Para quien ademas tiene que llevar el negocio, eso no es comodidad:
#   es la diferencia entre que el TLS siga vivo dentro de un ano o no.
#
# EL DOMINIO SALE DEL ENTORNO
#
#   `LICITAPRO_DOMINIO` en el .env. Sin definir, Caddy sirve en :80 sin TLS --
#   sirve para probar el despliegue y NO para produccion: la aplicacion manda
#   HSTS fuera de desarrollo, asi que sin certificado de verdad el navegador se
#   queda forzando https contra un puerto que no lo habla, y eso solo se
#   arregla limpiando el estado del navegador de cada visitante.
#
# PARA QUE IZIPAY PUEDA VERIFICAR
#
#   Piden que la web este "terminada y activa", y la revisan desde fuera. Eso
#   exige dominio propio y HTTPS valido: con autofirmado o con http a secas, la
#   revision no pasa.

{$LICITAPRO_DOMINIO::80} {
	# TOPE AL CUERPO DE LA PETICION, ANTES DE QUE LLEGUE A PYTHON
	#
	#   El panel corre en UN solo proceso uvicorn. Un POST de 2 GB contra
	#   cualquier ruta de subida se leia entero en memoria antes de que el
	#   codigo mirara el tamano, y ese proceso es el de todos los clientes.
	#   Aqui se corta en la puerta: Caddy responde 413 sin pasarlo.
	#
	#   15 MB deja sitio al archivo mas grande que se acepta (10 MB, los
	#   formatos de shared/llenar_formatos.MAX_BYTES; los PDF de
	#   web/empresas.MAX_PDF y las imagenes de shared/archivos.MAX_BYTES son de
	#   5 MB) mas la envoltura del multipart. Si se sube alguno de esos limites
	#   por encima, subir este con el.
	request_body {
		max_size 15MB
	}

	# CF-Connecting-IP SOLO SI LA PONE CLOUDFLARE
	#
	#   La aplicacion toma la IP del cliente de esa cabecera
	#   (web/limites.ip_del_cliente), porque Cloudflare la pisa siempre y nadie
	#   de fuera la puede elegir. Pero Caddy SI asoma a internet: quien le hable
	#   directo, sin pasar por Cloudflare, podria mandarla inventada. Se borra
	#   cuando la conexion no viene de un rango de Cloudflare.
	#
	#   Los rangos son los mismos que los de `trusted_proxies` de abajo. Si se
	#   refrescan alli, refrescarlos aqui.
	@sin_cloudflare {
		not {
			remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22
			remote_ip 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20
			remote_ip 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13
			remote_ip 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
			remote_ip 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32
			remote_ip 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		}
	}
	request_header @sin_cloudflare -Cf-Connecting-Ip

	# El panel corre en la red interna de compose, asi que se llega por el
	# nombre del servicio y no hace falta que publique puerto al exterior.
	reverse_proxy web:8200 {
		# CON CLOUDFLARE DELANTE, ESTO NO ES OPCIONAL.
		#
		# La aplicacion guarda la IP en `intentos_acceso` para frenar la fuerza
		# bruta contra las contrasenas. La saca de CF-Connecting-IP y, sin ella,
		# de la conexion -- que uvicorn rellena desde X-Forwarded-For solo si el
		# proxy esta en FORWARDED_ALLOW_IPS (ver Dockerfile). En este despliegue
		# el proxy es el contenedor de Caddy: hay que poner su subred en
		# FORWARDED_ALLOW_IPS del servicio web, nunca `*`.
		#
		# Sin esta lista, Caddy ve como cliente al borde de Cloudflare y pone
		# ESA ip en la cabecera. Resultado: todos los usuarios que salen por el
		# mismo borde comparten contador, y al primer atacante el freno los
		# bloquea a todos a la vez. Un ataque contra una cuenta se convierte en
		# una caida para muchas.
		#
		# Declarando los rangos de Cloudflare como proxies de confianza, Caddy
		# respeta el X-Forwarded-For que ellos mandan, que si trae la IP real.
		#
		# Estos rangos cambian de vez en cuando. Para refrescarlos:
		#   curl -s https://www.cloudflare.com/ips-v4
		#   curl -s https://www.cloudflare.com/ips-v6
		# Si se quedan viejos el fallo es silencioso: se vuelve al contador
		# compartido sin que nada avise.
		#
		# Sin Cloudflare delante esta lista sobra y no estorba: ninguna de esas
		# IPs sera nunca el cliente directo.
		trusted_proxies \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}

	encode gzip zstd

	# La aplicacion ya manda su propia Content-Security-Policy con nonce por
	# peticion, HSTS, X-Frame-Options y las demas. NO se repiten aqui: dos
	# origenes para la misma cabecera acaban discrepando, y el dia que se
	# endurezca la politica en el codigo el proxy seguiria mandando la vieja.
	header {
		# Esta si es cosa del proxy: que no anuncie que es Caddy.
		-Server
	}

	# Sin esto, un fallo del panel se ve como una pagina en blanco y no queda
	# rastro de que peticion lo provoco.
	log {
		output stdout
		format console
	}
}
