# Environment
.env
*.env

# Los respaldos con marca de tiempo NO los cubre ninguno de los dos patrones de
# arriba: `.env.respaldo-20260901-053747` ni es exactamente `.env` ni termina en
# `.env`. Y llevan dentro, en claro, la clave del buzon de correo.
#
# Ahora mismo hay cinco de esos archivos en el servidor de produccion. Estan sin
# trackear, asi que no han llegado al repositorio, pero bastaba un `git add -A`
# distraido para publicarlos.
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Data (runtime, no commitear)
data/
data/bases/
data/expedientes/
templates/output/

# Docker volumes
data/postgres/
data/n8n/
data/redis/

# Docker
*.log

# OS
.DS_Store
Thumbs.db

# Salidas de herramientas
graphify-out/

# Pruebas
.pytest_cache/

# Entorno aislado de la tarea programada que trae OECE desde esta maquina.
.venv-tarea/

# Volcado que deja Git Bash al morir. Basura local, nunca del repo.
bash.exe.stackdump
