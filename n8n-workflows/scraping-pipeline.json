{
  "name": "LicitaPro - Scraping Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 60 }]
        }
      },
      "id": "cron-trigger",
      "name": "Cada 60 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8100/api/scrape",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "sources", "value": "seace,ocds,contratos_menores" }
          ]
        },
        "options": { "timeout": 120000 }
      },
      "id": "scrape-critical",
      "name": "Scrape Fuentes Críticas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 200]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8100/api/scrape",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "sources", "value": "peru_compras,gore_portals,poder_judicial" }
          ]
        },
        "options": { "timeout": 120000 }
      },
      "id": "scrape-secondary",
      "name": "Scrape Fuentes Secundarias",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.total_nuevas }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "check-nuevas",
      "name": "¿Hay nuevas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "url": "https://api.telegram.org/bot{{ $env.RADAR_BOT_TOKEN }}/sendMessage",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $env.TELEGRAM_ADMIN_ID }}" },
            { "name": "text", "value": "📊 Scraping completado: {{ $json.total_nuevas }} nuevas licitaciones detectadas" },
            { "name": "parse_mode", "value": "Markdown" }
          ]
        }
      },
      "id": "notify-telegram",
      "name": "Notificar Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 200]
    },
    {
      "parameters": {},
      "id": "no-op",
      "name": "Sin nuevas",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [920, 400]
    }
  ],
  "connections": {
    "Cada 60 min": {
      "main": [
        [
          { "node": "Scrape Fuentes Críticas", "type": "main", "index": 0 },
          { "node": "Scrape Fuentes Secundarias", "type": "main", "index": 0 }
        ]
      ]
    },
    "Scrape Fuentes Críticas": {
      "main": [
        [{ "node": "¿Hay nuevas?", "type": "main", "index": 0 }]
      ]
    },
    "¿Hay nuevas?": {
      "main": [
        [{ "node": "Notificar Telegram", "type": "main", "index": 0 }],
        [{ "node": "Sin nuevas", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
